# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 鉴权（必填）
API_KEY=your-secret-api-key-here

# curl-cffi 默认配置
DEFAULT_IMPERSONATE=chrome
DEFAULT_TIMEOUT=30
DEFAULT_PROXY=

# 代理池配置（JSON 格式）
# 格式：{"标识符": {"url": "代理URL", "description": "描述"}}
#
# 代理使用方式：
# 1. 代理池映射（推荐用于常用代理）：在此配置代理池，请求时使用标识符（如 "hk", "sg"）
# 2. 直接传入代理 URL（适用于临时代理）：请求时直接传入完整代理 URL（如 "http://proxy:8080"）
#    - 支持协议：http://, https://, socks5://
#    - 自动识别：以协议开头则直接使用，否则从代理池查找
#
# 示例：
# PROXY_POOL={"sg": {"url": "http://sg-proxy.example.com:8080", "description": "新加坡代理"}, "cn": {"url": "socks5://cn-proxy.example.com:1080", "description": "中国代理"}, "us": {"url": "http://us-proxy.example.com:8080", "description": "美国代理"}}
PROXY_POOL={}

# html2text 配置
HTML2TEXT_BODY_WIDTH=0
HTML2TEXT_IGNORE_LINKS=false
HTML2TEXT_IGNORE_IMAGES=false

# 缓存配置（强制启用）
# 配置 Redis URL 后使用 Redis 缓存，否则使用内存缓存
CACHE_REDIS_URL=

# 缓存行为配置
CACHE_TOKEN_THRESHOLD=2000
CACHE_DEFAULT_CHUNK_SIZE=2000

# 缓存清理配置
CACHE_DELETE_DELAY_SECONDS=300
CACHE_TTL_SECONDS=1800
CACHE_CLEANUP_INTERVAL=300
